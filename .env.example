# ============================================================
# DebtFreedom — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Site ──────────────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://debtmeltpro.com

# ── Google AdSense ────────────────────────────────────────────
# Publisher ID from AdSense dashboard (format: ca-pub-XXXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXX

# Individual Ad Unit Slot IDs (from AdSense > Ads > By ad unit)
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=XXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=XXXXXXXXXX

# ── Google Analytics (GA4) ────────────────────────────────────
# Measurement ID from GA4 dashboard (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Search Console ─────────────────────────────────────
# Verification meta tag value (without the tag, just the content value)
GOOGLE_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Vercel (for CI/CD — set in GitHub Secrets, not here) ──────
# VERCEL_TOKEN=           # Set in GitHub Actions secrets
# VERCEL_ORG_ID=          # Set in GitHub Actions secrets
# VERCEL_PROJECT_ID=      # Set in GitHub Actions secrets
